# Copie para .env e preencha. No Vercel essas variáveis são criadas pelas integrações (Neon e Blob).
DATABASE_URL=postgresql://usuario:senha@host/banco?sslmode=require
DATABASE_URL_UNPOOLED=

# Recomendado: texto aleatório longo para assinar os logins
JWT_SECRET=

# Senha da conta secretaria@escola.com criada no primeiro deploy (padrão 123456)
ADMIN_SENHA=

# Foto de perfil e anexos do chat (Vercel Blob). Criada ao conectar um Blob Store ao projeto.
# Sem ela o site funciona, mas o envio de fotos/arquivos/áudio fica desativado, com aviso na tela.
BLOB_READ_WRITE_TOKEN=

# Tempo real (Ably). Chave de API da sua conta no Ably (formato appId.keyId:segredo).
# Fica só no servidor, nunca vai para o navegador. Sem ela o site usa polling (atualiza a cada poucos segundos).
ABLY_API_KEY=
