# Copie para .env e preencha. No Vercel essas variáveis são criadas pela integração com o Neon.
DATABASE_URL=postgresql://usuario:senha@host/banco?sslmode=require
DATABASE_URL_UNPOOLED=

# Recomendado: texto aleatório longo para assinar os logins
JWT_SECRET=

# Senha da conta secretaria@escola.com criada no primeiro deploy (padrão 123456)
ADMIN_SENHA=
